@using Follower.Models
@using Follower.Services
@inject IEgresadoService EgresadoService

<div class="mb-6 bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">

    <div class="px-6 py-4 flex justify-between items-center cursor-pointer hover:bg-gray-50 transition-colors" @onclick="ToggleExpandido">
        <h2 class="text-lg font-bold text-gray-900">Contribución social y educativa</h2>

        <div class="flex items-center space-x-4">
            @if (expandido && !mostrandoFormulario && (EgresadoModel.ContribucionesSociales.Any() || respondioSi == true))
            {
                <button type="button" @onclick:stopPropagation="true" @onclick="AbrirNuevoFormulario" class="text-sm font-medium text-[#003366] hover:underline">
                    + Agregar contribución
                </button>
            }
            <svg class="w-5 h-5 text-gray-500 transform transition-transform duration-200 @(expandido ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
        </div>
    </div>

    @if (expandido)
    {
        <div class="p-6 bg-slate-50 border-t border-gray-200">

            @if (!EgresadoModel.ContribucionesSociales.Any() && respondioSi == null)
            {
                <div class="p-4 bg-white border border-gray-200 rounded-md shadow-sm mb-4">
                    <p class="text-sm text-gray-800 mb-4 font-medium">¿Has realizado actividades o proyectos que hayan contribuido al mejoramiento de la educación o al beneficio de alguna comunidad o sector social después de tu egreso?</p>
                    <div class="flex space-x-6">
                        <label class="flex items-center space-x-2 cursor-pointer">
                            <input type="radio" name="tieneContribuciones" @onclick="() => Responder(true)" class="text-[#003366] focus:ring-[#003366]" />
                            <span class="text-sm text-gray-700">Sí</span>
                        </label>
                        <label class="flex items-center space-x-2 cursor-pointer">
                            <input type="radio" name="tieneContribuciones" @onclick="() => Responder(false)" class="text-[#003366] focus:ring-[#003366]" />
                            <span class="text-sm text-gray-700">No</span>
                        </label>
                    </div>
                </div>
            }

            @if (respondioSi == false && !EgresadoModel.ContribucionesSociales.Any())
            {
                <p class="text-sm text-gray-500 italic">Has indicado que no cuentas con contribuciones sociales registradas por el momento.</p>
                <button type="button" @onclick="() => Responder(null)" class="text-xs text-[#003366] hover:underline mt-2">Cambiar respuesta</button>
            }

            @if (EgresadoModel.ContribucionesSociales.Any())
            {
                <div class="space-y-4">
                    @foreach (var cont in EgresadoModel.ContribucionesSociales)
                    {
                        <div class="border border-gray-200 rounded-lg p-5 bg-white relative shadow-sm">
                            <div class="absolute top-4 right-5 flex space-x-3 text-[13px] font-medium text-slate-400">
                                <button type="button" @onclick="() => IniciarEdicion(cont)" class="hover:text-slate-600 transition-colors">Editar</button>
                                <button type="button" @onclick="() => ConfirmarEliminar(cont)" class="hover:text-red-500 transition-colors">Eliminar</button>
                            </div>

                            <p class="text-xs text-[#003366] font-bold mb-1 uppercase tracking-wide">@cont.TipoContribucion</p>
                            <h3 class="font-bold text-slate-900 text-lg mb-1 pr-32">@cont.NombreActividad</h3>
                            <p class="text-sm text-slate-600 mb-2"><strong>Beneficiario:</strong> @cont.SectorAtendido</p>

                            <div class="flex items-center text-xs text-slate-500 mb-3">
                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                <span>@(cont.FechaInicio?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                                <span class="mx-2">-</span>
                                <span>@(cont.FechaFin?.ToString("dd/MM/yyyy") ?? "Presente")</span>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-slate-100 pt-3 mt-2">
                                <div>
                                    <p class="text-[11px] font-bold text-slate-400 mb-0.5 uppercase">Descripción</p>
                                    <p class="text-sm text-slate-800 line-clamp-3">@cont.Descripcion</p>
                                </div>
                                <div>
                                    <p class="text-[11px] font-bold text-slate-400 mb-0.5 uppercase">Resultados o Beneficios</p>
                                    <p class="text-sm text-slate-800 line-clamp-3">@cont.Resultados</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (mostrandoFormulario)
            {
                <div class="border border-blue-100 bg-[#fbfdff] rounded-lg p-6 shadow-sm mt-4">
                    <h3 class="text-sm font-bold text-gray-900 mb-4 border-b pb-2">
                        @(registroEnEdicion != null ? "Editar actividad o proyecto de contribución social" : "Registrar actividad o proyecto de contribución social")
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">

                        <div class="md:col-span-2">
                            <label class="block text-xs text-gray-500 mb-1">Nombre de la actividad *</label>
                            <input type="text" @bind="nuevoRegistro.NombreActividad"
                                   class="w-full border @(TieneError("NombreActividad") ? "border-red-500" : "border-gray-300") rounded-md p-2 text-sm focus:ring-[#003366]"
                                   placeholder="Respuesta breve..." />
                            @if (TieneError("NombreActividad"))
                            {
                                <p class="text-red-500 text-xs mt-1">@errores["NombreActividad"]</p>
                            }
                        </div>

                        <div>
                            <label class="block text-xs text-gray-500 mb-1">Tipo de contribución *</label>
                            <select @bind="nuevoRegistro.TipoContribucion"
                                    class="w-full border @(TieneError("TipoContribucion") ? "border-red-500" : "border-gray-300") rounded-md p-2 text-sm bg-white focus:ring-[#003366]">
                                <option value="">Seleccione una categoría...</option>
                                <option value="Intervención comunitaria">Intervención comunitaria</option>
                                <option value="Capacitación o talleres gratuitos">Capacitación o talleres gratuitos</option>
                                <option value="Asesoría o consultoría social">Asesoría o consultoría social</option>
                                <option value="Divulgación científica o cultural">Divulgación científica o cultural</option>
                                <option value="Proyecto de desarrollo sustentable">Proyecto de desarrollo sustentable</option>
                                <option value="Voluntariado">Voluntariado</option>
                                <option value="Donación o procuración de fondos">Donación o procuración de fondos</option>
                                <option value="Otra">Otra</option>
                            </select>
                            @if (TieneError("TipoContribucion"))
                            {
                                <p class="text-red-500 text-xs mt-1">@errores["TipoContribucion"]</p>
                            }
                        </div>

                        <div>
                            <label class="block text-xs text-gray-500 mb-1">Institución o comunidad beneficiada *</label>
                            <input type="text" @bind="nuevoRegistro.SectorAtendido"
                                   class="w-full border @(TieneError("SectorAtendido") ? "border-red-500" : "border-gray-300") rounded-md p-2 text-sm focus:ring-[#003366]"
                                   placeholder="Sector atendido..." />
                            @if (TieneError("SectorAtendido"))
                            {
                                <p class="text-red-500 text-xs mt-1">@errores["SectorAtendido"]</p>
                            }
                        </div>

                        <div>
                            <label class="block text-xs text-gray-500 mb-1">Fecha de inicio *</label>
                            <input type="date" @bind="nuevoRegistro.FechaInicio"
                                   class="w-full border @(TieneError("FechaInicio") ? "border-red-500" : "border-gray-300") rounded-md p-2 text-sm focus:ring-[#003366]" />
                            @if (TieneError("FechaInicio"))
                            {
                                <p class="text-red-500 text-xs mt-1">@errores["FechaInicio"]</p>
                            }
                        </div>

                        <div>
                            <label class="block text-xs text-gray-500 mb-1">Fecha de conclusión (Opcional si sigue vigente)</label>
                            <input type="date" @bind="nuevoRegistro.FechaFin"
                                   class="w-full border @(TieneError("FechaFin") ? "border-red-500" : "border-gray-300") rounded-md p-2 text-sm focus:ring-[#003366]" />
                            @if (TieneError("FechaFin"))
                            {
                                <p class="text-red-500 text-xs mt-1">@errores["FechaFin"]</p>
                            }
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-xs text-gray-500 mb-1">Descripción * <span class="font-normal">(¿Qué hiciste y qué problema buscabas atender? Máx. 100 palabras)</span></label>
                            <textarea @bind="nuevoRegistro.Descripcion" rows="3"
                                      class="w-full border @(TieneError("Descripcion") ? "border-red-500" : "border-gray-300") rounded-md p-2 text-sm focus:ring-[#003366] resize-none"></textarea>
                            @if (TieneError("Descripcion"))
                            {
                                <p class="text-red-500 text-xs mt-1">@errores["Descripcion"]</p>
                            }
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-xs text-gray-500 mb-1">Resultados o beneficios * <span class="font-normal">(¿Qué se logró y a quiénes benefició? Máx. 100 palabras)</span></label>
                            <textarea @bind="nuevoRegistro.Resultados" rows="3"
                                      class="w-full border @(TieneError("Resultados") ? "border-red-500" : "border-gray-300") rounded-md p-2 text-sm focus:ring-[#003366] resize-none"></textarea>
                            @if (TieneError("Resultados"))
                            {
                                <p class="text-red-500 text-xs mt-1">@errores["Resultados"]</p>
                            }
                        </div>

                        <div class="md:col-span-2 mt-2">
                            <label class="block text-xs text-gray-500 mb-1">Evidencia (URL o archivo PDF, opcional)</label>
                            <div class="flex items-center space-x-3">
                                <input type="text" @bind="nuevoRegistro.ArchivoEvidencia" placeholder="https://..." class="flex-1 border border-gray-300 rounded-md p-2 text-sm focus:ring-[#003366]" />
                                <span class="text-xs text-gray-400 font-bold">O</span>
                                <label class="flex items-center justify-center px-4 py-2 border border-gray-300 rounded-md cursor-pointer bg-gray-50 hover:bg-gray-100 text-sm font-medium text-gray-700">
                                    <span>Subir PDF</span>
                                    <input type="file" class="hidden" accept=".pdf" />
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="flex justify-end space-x-3 mt-4 pt-4 border-t border-gray-200">
                        <button type="button" @onclick="Cancelar" class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-800">Cancelar</button>
                        <button type="button" @onclick="Guardar" disabled="@guardando" class="px-4 py-2 bg-[#003366] text-white text-sm font-medium rounded-md hover:bg-[#002244] disabled:opacity-50">
                            @(registroEnEdicion != null ? "Actualizar contribución" : "Guardar contribución")
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public Egresado EgresadoModel { get; set; } = null!;

    [Parameter]
    public EventCallback<string> OnNotificar { get; set; }

    private bool expandido = false;
    private bool mostrandoFormulario = false;
    private bool guardando = false;
    private bool? respondioSi = null;

    private ContribucionSocial nuevoRegistro = new();
    private ContribucionSocial? registroEnEdicion = null;
    private Dictionary<string, string> errores = new();

    private void ToggleExpandido() => expandido = !expandido;

    private bool TieneError(string campo) => errores.ContainsKey(campo);

    private void Responder(bool? respuesta)
    {
        respondioSi = respuesta;
        if (respuesta == true)
        {
            AbrirNuevoFormulario();
        }
        else
        {
            mostrandoFormulario = false;
        }
    }

    private void AbrirNuevoFormulario()
    {
        errores.Clear();
        registroEnEdicion = null;
        nuevoRegistro = new ContribucionSocial();
        mostrandoFormulario = true;
    }

    private void IniciarEdicion(ContribucionSocial cont)
    {
        errores.Clear();
        registroEnEdicion = cont;
        nuevoRegistro = new ContribucionSocial
        {
            IdContribucion = cont.IdContribucion,
            EgresadoId = cont.EgresadoId,
            NombreActividad = cont.NombreActividad,
            TipoContribucion = cont.TipoContribucion,
            SectorAtendido = cont.SectorAtendido,
            FechaInicio = cont.FechaInicio,
            FechaFin = cont.FechaFin,
            Descripcion = cont.Descripcion,
            Resultados = cont.Resultados,
            ArchivoEvidencia = cont.ArchivoEvidencia
        };
        mostrandoFormulario = true;
    }

    private bool ValidarFormulario()
    {
        errores.Clear();

        if (string.IsNullOrWhiteSpace(nuevoRegistro.NombreActividad))
            errores["NombreActividad"] = "El nombre de la actividad es obligatorio.";

        if (string.IsNullOrWhiteSpace(nuevoRegistro.TipoContribucion))
            errores["TipoContribucion"] = "El tipo de contribución es obligatorio.";

        if (string.IsNullOrWhiteSpace(nuevoRegistro.SectorAtendido))
            errores["SectorAtendido"] = "La institución o comunidad beneficiada es obligatoria.";

        if (!nuevoRegistro.FechaInicio.HasValue)
            errores["FechaInicio"] = "La fecha de inicio es obligatoria.";

        if (nuevoRegistro.FechaInicio.HasValue && nuevoRegistro.FechaFin.HasValue
            && nuevoRegistro.FechaFin.Value < nuevoRegistro.FechaInicio.Value)
        {
            errores["FechaFin"] = "La fecha de conclusión no puede ser anterior a la de inicio.";
        }

        if (string.IsNullOrWhiteSpace(nuevoRegistro.Descripcion))
            errores["Descripcion"] = "La descripción es obligatoria.";

        if (string.IsNullOrWhiteSpace(nuevoRegistro.Resultados))
            errores["Resultados"] = "Los resultados o beneficios son obligatorios.";

        return !errores.Any();
    }

    private async Task Guardar()
    {
        if (guardando) return;

        if (!ValidarFormulario())
        {
            await OnNotificar.InvokeAsync("Completa todos los campos obligatorios marcados en rojo.");
            return;
        }

        guardando = true;

        var esEdicion = registroEnEdicion != null;
        var target = registroEnEdicion;
        var copiaNuevo = nuevoRegistro;

        ContribucionSocial? respaldo = null;
        if (esEdicion && target != null)
        {
            respaldo = new ContribucionSocial
            {
                NombreActividad = target.NombreActividad,
                TipoContribucion = target.TipoContribucion,
                SectorAtendido = target.SectorAtendido,
                FechaInicio = target.FechaInicio,
                FechaFin = target.FechaFin,
                Descripcion = target.Descripcion,
                Resultados = target.Resultados,
                ArchivoEvidencia = target.ArchivoEvidencia
            };

            target.NombreActividad = copiaNuevo.NombreActividad;
            target.TipoContribucion = copiaNuevo.TipoContribucion;
            target.SectorAtendido = copiaNuevo.SectorAtendido;
            target.FechaInicio = copiaNuevo.FechaInicio;
            target.FechaFin = copiaNuevo.FechaFin;
            target.Descripcion = copiaNuevo.Descripcion;
            target.Resultados = copiaNuevo.Resultados;
            target.ArchivoEvidencia = copiaNuevo.ArchivoEvidencia;
        }
        else
        {
            copiaNuevo.EgresadoId = EgresadoModel.IdEgresado;
            EgresadoModel.ContribucionesSociales.Add(copiaNuevo);
        }

        // Cierre instantáneo
        respondioSi = null;
        Cancelar();
        StateHasChanged();

        try
        {
            await EgresadoService.ActualizarAsync(EgresadoModel);
            await OnNotificar.InvokeAsync(esEdicion
                ? "Contribución social actualizada exitosamente."
                : "Contribución social registrada exitosamente.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar contribución: {ex.Message}");
            if (esEdicion && target != null && respaldo != null)
            {
                target.NombreActividad = respaldo.NombreActividad;
                target.TipoContribucion = respaldo.TipoContribucion;
                target.SectorAtendido = respaldo.SectorAtendido;
                target.FechaInicio = respaldo.FechaInicio;
                target.FechaFin = respaldo.FechaFin;
                target.Descripcion = respaldo.Descripcion;
                target.Resultados = respaldo.Resultados;
                target.ArchivoEvidencia = respaldo.ArchivoEvidencia;
            }
            else
            {
                EgresadoModel.ContribucionesSociales.Remove(copiaNuevo);
            }
            await OnNotificar.InvokeAsync("Error de conexión al guardar.");
        }
        finally
        {
            guardando = false;
        }
    }

    private void Cancelar()
    {
        errores.Clear();
        registroEnEdicion = null;
        nuevoRegistro = new ContribucionSocial();
        mostrandoFormulario = false;

        if (!EgresadoModel.ContribucionesSociales.Any())
        {
            respondioSi = null;
        }
    }

    private async Task ConfirmarEliminar(ContribucionSocial cont)
    {
        try
        {
            if (cont.IdContribucion > 0)
            {
                await EgresadoService.EliminarContribucionSocialAsync(cont);
            }

            EgresadoModel.ContribucionesSociales.Remove(cont);
            await OnNotificar.InvokeAsync("Registro eliminado.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar contribución: {ex.Message}");
            await OnNotificar.InvokeAsync("No se pudo eliminar el registro.");
        }
    }
}