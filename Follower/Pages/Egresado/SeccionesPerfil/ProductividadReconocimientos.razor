@page "/perfil/productividad"
@using Microsoft.AspNetCore.Components.Authorization
@using Follower.Services
@using Follower.Models
@inject AuthenticationStateProvider AuthStateProvider
@inject IEgresadoService EgresadoService

@if (cargando)
{
    <div class="flex justify-center items-center min-h-[400px]">
        <p class="text-gray-500">Cargando información...</p>
    </div>
}

else if (egresado != null)
{
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Productividad y reconocimientos</h1>
        <p class="text-gray-500">Registra tus publicaciones científicas, proyectos de investigación, distinciones y contribuciones.</p>
    </div>

    <div class="space-y-6">
        <!-- Secciones -->
        <SeccionProductividadCientifica EgresadoModel="egresado" OnNotificar="MostrarNotificacion" />

    </div>

    <!-- Notificacion -->
    @if (!string.IsNullOrEmpty(mensajeNotificacion))
    {
        <div class="fixed bottom-6 right-6 bg-white text-slate-800 px-5 py-3 rounded-md shadow-lg border border-slate-100 flex items-center z-50">
            <svg class="w-5 h-5 mr-3 text-[#03126B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span class="text-sm font-normal">@mensajeNotificacion</span>
        </div>
    }

}


@code {
    private bool cargando = true;
    private Egresado? egresado;
    private string? mensajeNotificacion = null;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            var userIdString = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(userIdString, out int userId))
            {
                egresado = await EgresadoService.ObtenerPorUsuarioIdAsync(userId);    
            }
        }

    }

    private async Task MostrarNotificacion (string mensaje)
    {
        mensajeNotificacion = mensaje;
        StateHasChanged();
        await Task.Delay(3000);
        mensajeNotificacion = null;
        StateHasChanged();
    }
}
