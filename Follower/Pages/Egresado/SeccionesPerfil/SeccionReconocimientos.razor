@using Follower.Models
@using Follower.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IEgresadoService EgresadoService
@inject PdfEvidenceStorage EvidenceStorage
@inject IJSRuntime JS

<div class="mb-6 bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">

    <!-- CABECERA DEL ACORDEÓN -->
    <div class="px-6 py-4 flex justify-between items-center cursor-pointer hover:bg-gray-50 transition-colors" @onclick="ToggleExpandido">
        <h2 class="text-lg font-bold text-gray-900">Distinciones y membresías académicas</h2>

        <div class="flex items-center space-x-4">
            @if (expandido && !mostrandoFormulario)
            {
                <button type="button" @onclick:stopPropagation="true" @onclick="AbrirNuevoFormulario" class="text-sm font-medium text-[#003366] hover:underline">
                    + Registrar distinción
                </button>
            }
            <svg class="w-5 h-5 text-gray-500 transform transition-transform duration-200 @(expandido ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
        </div>
    </div>

    <!-- CONTENIDO DEL ACORDEÓN -->
    @if (expandido)
    {
        <div class="p-6 bg-slate-50 border-t border-gray-200">

            <!-- Lista de Reconocimientos Guardados -->
            @if (EgresadoModel.ReconocimientosAcademicos.Any())
            {
                <div class="space-y-4">
                    @foreach (var rec in EgresadoModel.ReconocimientosAcademicos)
                    {
                        <div class="border border-gray-200 rounded-lg p-5 bg-white relative shadow-sm">
                            <div class="absolute top-4 right-5 flex space-x-3 text-[13px] font-medium text-slate-400">
                                <button type="button" @onclick="() => IniciarEdicion(rec)" class="hover:text-slate-600 transition-colors">Editar</button>
                                <button type="button" @onclick="() => ConfirmarEliminar(rec)" class="hover:text-red-500 transition-colors">Eliminar</button>
                            </div>

                            <p class="text-xs text-[#003366] font-bold mb-1 uppercase tracking-wide">@rec.TipoRegistro</p>

                            @if (!string.IsNullOrEmpty(rec.NombreReconocimiento))
                            {
                                <h3 class="font-bold text-slate-900 text-lg mb-1 pr-32">@rec.NombreReconocimiento</h3>
                            }
                            else if (!string.IsNullOrEmpty(rec.Nivel))
                            {
                                <h3 class="font-bold text-slate-900 text-lg mb-1 pr-32">Nivel: @rec.Nivel</h3>
                            }

                            @if (!string.IsNullOrEmpty(rec.InstitucionOtorgante))
                            {
                                <p class="text-sm text-slate-600 mb-2">@rec.InstitucionOtorgante</p>
                            }

                            @if (!string.IsNullOrEmpty(rec.MotivoOCategoria))
                            {
                                <p class="text-sm text-slate-500 mb-2 italic">@rec.MotivoOCategoria</p>
                            }

                            <div class="flex flex-wrap gap-x-6 gap-y-2 border-t border-slate-100 pt-3 mt-2">
                                @if (rec.AnoInicio > 0)
                                {
                                    <div>
                                        <p class="text-[11px] font-bold text-slate-400 mb-0.5 uppercase">
                                            @(rec.TipoRegistro == "Premio o Distinción" || rec.TipoRegistro == "Certificación" ? "Año de obtención" : "Año inicio")
                                        </p>
                                        <p class="text-sm text-slate-800">@rec.AnoInicio</p>
                                    </div>
                                }
                                @if (rec.AnoFin > 0)
                                {
                                    <div>
                                        <p class="text-[11px] font-bold text-slate-400 mb-0.5 uppercase">Año término / Vigencia</p>
                                        <p class="text-sm text-slate-800">@rec.AnoFin</p>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(rec.TipoParticipacion))
                                {
                                    <div>
                                        <p class="text-[11px] font-bold text-slate-400 mb-0.5 uppercase">Participación</p>
                                        <p class="text-sm text-slate-800">@rec.TipoParticipacion</p>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(rec.EstadoActual))
                                {
                                    <div>
                                        <p class="text-[11px] font-bold text-slate-400 mb-0.5 uppercase">Situación actual</p>
                                        <p class="text-sm text-slate-800">@rec.EstadoActual</p>
                                    </div>
                                }
                            </div>
                            @if (EvidenceStorage.IsStoredEvidence(rec.ArchivoEvidencia))
                            {
                                <button type="button" @onclick="() => DescargarEvidencia(rec.ArchivoEvidencia)" class="inline-block mt-3 text-sm text-[#003366] hover:underline">
                                    Descargar constancia o evidencia
                                </button>
                            }
                            else if (EvidenceStorage.GetExternalUrl(rec.ArchivoEvidencia) is string evidenciaUrl)
                            {
                                <a href="@evidenciaUrl" target="_blank" rel="noopener noreferrer" class="inline-block mt-3 text-sm text-[#003366] hover:underline">
                                    Ver constancia o evidencia
                                </a>
                            }
                        </div>
                    }
                </div>
            }
            else if (!mostrandoFormulario)
            {
                <p class="text-sm text-gray-500 italic">No has registrado premios, certificaciones o membresías.</p>
            }

            <!-- Formulario de Nuevo Registro / Edición -->
            @if (mostrandoFormulario)
            {
                <div class="border border-blue-100 bg-[#fbfdff] rounded-lg p-6 shadow-sm mt-4">
                    <h3 class="text-sm font-bold text-gray-900 mb-4 border-b pb-2">
                        @(registroEnEdicion != null ? "Editar distinción o membresía" : "Registro de distinciones y membresías")
                    </h3>

                    <div class="mb-4">
                        <label class="block text-xs font-bold text-gray-700 mb-1">Tipo de registro *</label>
                        <select @bind="nuevoRegistro.TipoRegistro" class="w-full border @(TieneError("TipoRegistro") ? "border-red-500" : "border-gray-300") rounded-md p-2 text-sm focus:ring-[#003366] bg-white">
                            <option value="">Seleccione una opción...</option>
                            <option value="Sistema Nacional de Investigadores (SNII)">Sistema Nacional de Investigadores (SNII)</option>
                            <option value="Reconocimiento PRODEP">Reconocimiento PRODEP</option>
                            <option value="Premio o Distinción">Premio o distinción académica/profesional</option>
                            <option value="Certificación">Certificación o acreditación profesional</option>
                            <option value="Membresía">Membresía en asociaciones o redes</option>
                        </select>
                        @if (TieneError("TipoRegistro"))
                        {
                            <p class="text-red-500 text-xs mt-1">@errores["TipoRegistro"]</p>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(nuevoRegistro.TipoRegistro))
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">

                            <!-- Campos para SNII -->
                            @if (nuevoRegistro.TipoRegistro.Contains("SNII"))
                            {
                                <div class="md:col-span-2">
                                    <label class="block text-xs text-gray-500 mb-1">Nivel obtenido *</label>
                                    <select @bind="nuevoRegistro.Nivel" class="w-full border @(TieneError("Nivel") ? "border-red-500" : "border-gray-300") rounded-md p-2 text-sm focus:ring-[#003366] bg-white">
                                        <option value="">Seleccione un nivel...</option>
                                        <option value="Candidato(a)">Candidato(a)</option>
                                        <option value="Nivel I">Nivel I</option>
                                        <option value="Nivel II">Nivel II</option>
                                        <option value="Nivel III">Nivel III</option>
                                        <option value="Emérito(a)">Emérito(a)</option>
                                    </select>
                                    @if (TieneError("Nivel"))
                                    {
                                        <p class="text-red-500 text-xs mt-1">@errores["Nivel"]</p>
                                    }
                                </div>
                            }

                            <!-- Campos para Premios, Certificaciones y Membresías -->
                            @if (nuevoRegistro.TipoRegistro == "Premio o Distinción" || nuevoRegistro.TipoRegistro == "Certificación" || nuevoRegistro.TipoRegistro == "Membresía")
                            {
                                <div class="md:col-span-2">
                                    <label class="block text-xs text-gray-500 mb-1">
                                        @(nuevoRegistro.TipoRegistro == "Membresía" ? "Nombre de la organización (AMC, COMIE, etc.) *" : "Nombre de la distinción / certificación *")
                                    </label>
                                    <input type="text" @bind="nuevoRegistro.NombreReconocimiento" class="w-full border @(TieneError("NombreReconocimiento") ? "border-red-500" : "border-gray-300") rounded-md p-2 text-sm focus:ring-[#003366]" />
                                    @if (TieneError("NombreReconocimiento"))
                                    {
                                        <p class="text-red-500 text-xs mt-1">@errores["NombreReconocimiento"]</p>
                                    }
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-xs text-gray-500 mb-1">Institución u organismo otorgante *</label>
                                    <input type="text" @bind="nuevoRegistro.InstitucionOtorgante" class="w-full border @(TieneError("InstitucionOtorgante") ? "border-red-500" : "border-gray-300") rounded-md p-2 text-sm focus:ring-[#003366]" />
                                    @if (TieneError("InstitucionOtorgante"))
                                    {
                                        <p class="text-red-500 text-xs mt-1">@errores["InstitucionOtorgante"]</p>
                                    }
                                </div>
                            }

                            <!-- Campo opcional para Premios -->
                            @if (nuevoRegistro.TipoRegistro == "Premio o Distinción")
                            {
                                <div class="md:col-span-2">
                                    <label class="block text-xs text-gray-500 mb-1">Motivo o categoría (Opcional)</label>
                                    <input type="text" @bind="nuevoRegistro.MotivoOCategoria" class="w-full border border-gray-300 rounded-md p-2 text-sm focus:ring-[#003366]" />
                                </div>
                            }

                            <!-- Campo específico de Rol para Membresía -->
                            @if (nuevoRegistro.TipoRegistro == "Membresía")
                            {
                                <div>
                                    <label class="block text-xs text-gray-500 mb-1">Tipo de participación *</label>
                                    <select @bind="nuevoRegistro.TipoParticipacion" class="w-full border @(TieneError("TipoParticipacion") ? "border-red-500" : "border-gray-300") rounded-md p-2 text-sm focus:ring-[#003366] bg-white">
                                        <option value="">Seleccione...</option>
                                        <option value="Miembro">Miembro</option>
                                        <option value="Integrante de comité">Integrante de comité o comisión</option>
                                        <option value="Integrante directivo">Integrante de consejo directivo</option>
                                        <option value="Coordinador(a)">Coordinador(a)</option>
                                        <option value="Presidente(a)">Presidente(a)</option>
                                        <option value="Otro">Otro</option>
                                    </select>
                                    @if (TieneError("TipoParticipacion"))
                                    {
                                        <p class="text-red-500 text-xs mt-1">@errores["TipoParticipacion"]</p>
                                    }
                                </div>
                                <div>
                                    <label class="block text-xs text-gray-500 mb-1">Situación actual *</label>
                                    <select @bind="nuevoRegistro.EstadoActual" class="w-full border @(TieneError("EstadoActual") ? "border-red-500" : "border-gray-300") rounded-md p-2 text-sm focus:ring-[#003366] bg-white">
                                        <option value="">Seleccione...</option>
                                        <option value="Vigente">Vigente</option>
                                        <option value="Concluida">Concluida</option>
                                    </select>
                                    @if (TieneError("EstadoActual"))
                                    {
                                        <p class="text-red-500 text-xs mt-1">@errores["EstadoActual"]</p>
                                    }
                                </div>
                            }

                            <!-- Fechas (Comunes) -->
                            <div>
                                <label class="block text-xs text-gray-500 mb-1">
                                    @(nuevoRegistro.TipoRegistro == "Premio o Distinción" || nuevoRegistro.TipoRegistro == "Certificación" ? "Fecha de obtención *" : "Fecha de inicio / ingreso *")
                                </label>
                                <input type="date" @bind="fechaInicioTemp"
                                       class="w-full border @(TieneError("AnoInicio") ? "border-red-500" : "border-gray-300") rounded-md p-2 text-sm focus:ring-[#003366]" />
                                @if (TieneError("AnoInicio"))
                                {
                                    <p class="text-red-500 text-xs mt-1">@errores["AnoInicio"]</p>
                                }
                            </div>

                            @if (nuevoRegistro.TipoRegistro != "Premio o Distinción")
                            {
                                <div>
                                    <label class="block text-xs text-gray-500 mb-1">
                                        Fecha de término / Vigencia @(nuevoRegistro.TipoRegistro == "Membresía" && nuevoRegistro.EstadoActual == "Concluida" ? "*" : "(Opcional si es vigente)")
                                    </label>
                                    <input type="date" @bind="fechaFinTemp"
                                           disabled="@(nuevoRegistro.TipoRegistro == "Membresía" && nuevoRegistro.EstadoActual == "Vigente")"
                                           class="w-full border @(TieneError("AnoFin") ? "border-red-500" : "border-gray-300") rounded-md p-2 text-sm focus:ring-[#003366] disabled:bg-gray-100 disabled:text-gray-400" />
                                    @if (TieneError("AnoFin"))
                                    {
                                        <p class="text-red-500 text-xs mt-1">@errores["AnoFin"]</p>
                                    }
                                </div>
                            }

                            <!-- Carga de Evidencia -->
                            <div class="md:col-span-2 mt-2">
                                <label class="block text-xs text-gray-500 mb-1">Constancia o evidencia (Opcional)</label>
                                <div class="flex items-center justify-center w-full">
                                    <label class="flex flex-col items-center justify-center w-full h-16 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer bg-gray-50 hover:bg-gray-100">
                                        <div class="flex flex-col items-center justify-center pt-2 pb-2">
                                            <p class="text-xs text-gray-500"><span class="font-semibold">@(archivoSeleccionado?.Name ?? "Adjuntar PDF")</span> (Máx. 5 MB)</p>
                                        </div>
                                        <InputFile OnChange="SeleccionarArchivo" class="hidden" accept=".pdf,application/pdf" />
                                    </label>
                                </div>
                                @if (!string.IsNullOrEmpty(errorArchivo))
                                {
                                    <p class="text-red-500 text-xs mt-1">@errorArchivo</p>
                                }
                                else if (archivoSeleccionado == null && !string.IsNullOrEmpty(nuevoRegistro.ArchivoEvidencia))
                                {
                                    <p class="text-xs text-gray-500 mt-1">Hay una evidencia guardada. Selecciona otro PDF para reemplazarla.</p>
                                }
                            </div>
                        </div>

                        <div class="flex justify-end space-x-3 mt-4 pt-4 border-t border-gray-200">
                            <button type="button" @onclick="Cancelar" class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-800">Cancelar</button>
                            <button type="button" @onclick="Guardar" disabled="@guardando" class="px-4 py-2 bg-[#003366] text-white text-sm font-medium rounded-md hover:bg-[#002244] disabled:opacity-50">
                                @(registroEnEdicion != null ? "Actualizar registro" : "Guardar registro")
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public Egresado EgresadoModel { get; set; } = null!;

    [Parameter]
    public EventCallback<string> OnNotificar { get; set; }

    private bool expandido = false;
    private bool mostrandoFormulario = false;
    private bool guardando = false;
    private DateTime? fechaInicioTemp;
    private DateTime? fechaFinTemp;
    private ReconocimientoAcademico nuevoRegistro = new();
    private ReconocimientoAcademico? registroEnEdicion = null;
    private Dictionary<string, string> errores = new();
    private IBrowserFile? archivoSeleccionado;
    private string? errorArchivo;

    private void ToggleExpandido() => expandido = !expandido;

    private bool TieneError(string campo) => errores.ContainsKey(campo);

    private void AbrirNuevoFormulario()
    {
        errores.Clear();
        registroEnEdicion = null;
        nuevoRegistro = new ReconocimientoAcademico();
        fechaInicioTemp = null;
        fechaFinTemp = null;
        archivoSeleccionado = null;
        errorArchivo = null;
        mostrandoFormulario = true;
    }

    private void SeleccionarArchivo(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (!string.Equals(Path.GetExtension(file.Name), ".pdf", StringComparison.OrdinalIgnoreCase))
        {
            archivoSeleccionado = null;
            errorArchivo = "Selecciona un archivo PDF.";
            return;
        }

        if (file.Size == 0 || file.Size > PdfEvidenceStorage.MaxFileSize)
        {
            archivoSeleccionado = null;
            errorArchivo = "El PDF debe pesar más de 0 y como máximo 5 MB.";
            return;
        }

        archivoSeleccionado = file;
        errorArchivo = null;
    }

    private async Task DescargarEvidencia(string? relativePath)
    {
        if (string.IsNullOrWhiteSpace(relativePath) || !EvidenceStorage.IsStoredEvidence(relativePath))
        {
            return;
        }

        try
        {
            await using var stream = EvidenceStorage.OpenReadStream(relativePath);
            using var streamReference = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", "evidencia.pdf", streamReference);
        }
        catch (IOException ex)
        {
            Console.WriteLine($"Error al abrir evidencia: {ex.Message}");
            await OnNotificar.InvokeAsync("No se pudo abrir la evidencia.");
        }
        catch (JSException ex)
        {
            Console.WriteLine($"Error al descargar evidencia: {ex.Message}");
            await OnNotificar.InvokeAsync("No se pudo descargar la evidencia.");
        }
    }

    private void IniciarEdicion(ReconocimientoAcademico rec)
    {
        errores.Clear();
        registroEnEdicion = rec;
        nuevoRegistro = new ReconocimientoAcademico
            {
                IdReconomiento = rec.IdReconomiento,
                EgresadoId = rec.EgresadoId,
                TipoRegistro = rec.TipoRegistro,
                Nivel = rec.Nivel,
                AnoInicio = rec.AnoInicio,
                AnoFin = rec.AnoFin,
                NombreReconocimiento = rec.NombreReconocimiento,
                InstitucionOtorgante = rec.InstitucionOtorgante,
                MotivoOCategoria = rec.MotivoOCategoria,
                TipoParticipacion = rec.TipoParticipacion,
                EstadoActual = rec.EstadoActual,
                ArchivoEvidencia = rec.ArchivoEvidencia
            };

        fechaInicioTemp = rec.AnoInicio is >= 1950 and <= 2100 ? new DateTime(rec.AnoInicio.Value, 1, 1) : null;
        fechaFinTemp = rec.AnoFin is >= 1950 and <= 2100 ? new DateTime(rec.AnoFin.Value, 1, 1) : null;
        archivoSeleccionado = null;
        errorArchivo = null;
        mostrandoFormulario = true;
    }

    private bool ValidarFormulario()
    {
        errores.Clear();

        if (string.IsNullOrWhiteSpace(nuevoRegistro.TipoRegistro))
            errores["TipoRegistro"] = "Debes seleccionar un tipo de registro.";

        if (nuevoRegistro.TipoRegistro.Contains("SNII") && string.IsNullOrWhiteSpace(nuevoRegistro.Nivel))
            errores["Nivel"] = "El nivel obtenido es obligatorio.";

        if (nuevoRegistro.TipoRegistro == "Premio o Distinción"
            || nuevoRegistro.TipoRegistro == "Certificación"
            || nuevoRegistro.TipoRegistro == "Membresía")
        {
            if (string.IsNullOrWhiteSpace(nuevoRegistro.NombreReconocimiento))
                errores["NombreReconocimiento"] = "Este campo es obligatorio.";

            if (string.IsNullOrWhiteSpace(nuevoRegistro.InstitucionOtorgante))
                errores["InstitucionOtorgante"] = "La institución u organismo otorgante es obligatorio.";
        }

        if (nuevoRegistro.TipoRegistro == "Membresía")
        {
            if (string.IsNullOrWhiteSpace(nuevoRegistro.TipoParticipacion))
                errores["TipoParticipacion"] = "El tipo de participación es obligatorio.";

            if (string.IsNullOrWhiteSpace(nuevoRegistro.EstadoActual))
                errores["EstadoActual"] = "La situación actual es obligatoria.";
        }

        if (!fechaInicioTemp.HasValue)
            errores["AnoInicio"] = "La fecha de inicio es obligatoria.";

        if (nuevoRegistro.TipoRegistro == "Membresía" && nuevoRegistro.EstadoActual == "Concluida" && !fechaFinTemp.HasValue)
            errores["AnoFin"] = "La fecha de término es obligatoria si la membresía concluyó.";

        if (nuevoRegistro.TipoRegistro != "Premio o Distinción" && fechaInicioTemp.HasValue && fechaFinTemp.HasValue)
        {
            if (fechaFinTemp.Value < fechaInicioTemp.Value)
                errores["AnoFin"] = "La fecha de término no puede ser anterior a la de inicio.";
        }

        return !errores.Any();
    }

    private async Task Guardar()
    {
        if (guardando) return;

        if (!ValidarFormulario())
        {
            await OnNotificar.InvokeAsync("Completa todos los campos obligatorios marcados en rojo.");
            return;
        }

        guardando = true;

        string? archivoNuevo = null;
        try
        {
            if (archivoSeleccionado != null)
            {
                archivoNuevo = await EvidenceStorage.SaveAsync(archivoSeleccionado);
            }
        }
        catch (InvalidDataException ex)
        {
            errorArchivo = ex.Message;
            guardando = false;
            return;
        }
        catch (IOException ex)
        {
            Console.WriteLine($"Error al subir evidencia: {ex.Message}");
            errorArchivo = "No se pudo guardar el archivo. Inténtalo de nuevo.";
            guardando = false;
            return;
        }
        catch (UnauthorizedAccessException ex)
        {
            Console.WriteLine($"Error de permisos al guardar evidencia: {ex.Message}");
            errorArchivo = "No se pudo guardar el archivo. Inténtalo de nuevo.";
            guardando = false;
            return;
        }

        var esEdicion = registroEnEdicion != null;
        var target = registroEnEdicion;
        var copiaNuevo = nuevoRegistro;
        ReconocimientoAcademico? respaldo = null;
        var archivoAnterior = target?.ArchivoEvidencia;
        if (archivoNuevo != null)
        {
            copiaNuevo.ArchivoEvidencia = archivoNuevo;
        }

        copiaNuevo.AnoInicio = fechaInicioTemp!.Value.Year;
        copiaNuevo.AnoFin = (nuevoRegistro.TipoRegistro == "Premio o Distinción"
            || (nuevoRegistro.TipoRegistro == "Membresía" && nuevoRegistro.EstadoActual == "Vigente")
            || !fechaFinTemp.HasValue)
            ? 0
            : fechaFinTemp.Value.Year;

        if (esEdicion && target != null)
        {
            respaldo = new ReconocimientoAcademico
            {
                TipoRegistro = target.TipoRegistro,
                Nivel = target.Nivel,
                AnoInicio = target.AnoInicio,
                AnoFin = target.AnoFin,
                NombreReconocimiento = target.NombreReconocimiento,
                InstitucionOtorgante = target.InstitucionOtorgante,
                MotivoOCategoria = target.MotivoOCategoria,
                TipoParticipacion = target.TipoParticipacion,
                EstadoActual = target.EstadoActual,
                ArchivoEvidencia = target.ArchivoEvidencia
            };

            target.TipoRegistro = copiaNuevo.TipoRegistro;
            target.Nivel = copiaNuevo.Nivel;
            target.AnoInicio = copiaNuevo.AnoInicio;
            target.AnoFin = copiaNuevo.AnoFin;
            target.NombreReconocimiento = copiaNuevo.NombreReconocimiento;
            target.InstitucionOtorgante = copiaNuevo.InstitucionOtorgante;
            target.MotivoOCategoria = copiaNuevo.MotivoOCategoria;
            target.TipoParticipacion = copiaNuevo.TipoParticipacion;
            target.EstadoActual = copiaNuevo.EstadoActual;
            target.ArchivoEvidencia = copiaNuevo.ArchivoEvidencia;
        }
        else
        {
            copiaNuevo.EgresadoId = EgresadoModel.IdEgresado;
            EgresadoModel.ReconocimientosAcademicos.Add(copiaNuevo);
        }

        errores.Clear();
        registroEnEdicion = null;
        nuevoRegistro = new ReconocimientoAcademico();
        fechaInicioTemp = null;
        fechaFinTemp = null;
        archivoSeleccionado = null;
        errorArchivo = null;
        mostrandoFormulario = false;
        StateHasChanged();

        try
        {
            await EgresadoService.ActualizarAsync(EgresadoModel);
            if (archivoNuevo != null && !string.IsNullOrEmpty(archivoAnterior))
            {
                try
                {
                    EvidenceStorage.Delete(archivoAnterior);
                }
                catch (IOException ex)
                {
                    Console.WriteLine($"No se pudo eliminar la evidencia anterior: {ex.Message}");
                }
                catch (UnauthorizedAccessException ex)
                {
                    Console.WriteLine($"No hay permisos para eliminar la evidencia anterior: {ex.Message}");
                }
            }
            await OnNotificar.InvokeAsync(esEdicion
                ? "Registro actualizado exitosamente."
                : "Registro guardado exitosamente.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar distinción: {ex.Message}");
            if (archivoNuevo != null)
            {
                try
                {
                    EvidenceStorage.Delete(archivoNuevo);
                }
                catch (IOException cleanupException)
                {
                    Console.WriteLine($"No se pudo limpiar el archivo subido: {cleanupException.Message}");
                }
                catch (UnauthorizedAccessException cleanupException)
                {
                    Console.WriteLine($"No hay permisos para limpiar el archivo subido: {cleanupException.Message}");
                }
            }
            if (esEdicion && target != null && respaldo != null)
            {
                target.TipoRegistro = respaldo.TipoRegistro;
                target.Nivel = respaldo.Nivel;
                target.AnoInicio = respaldo.AnoInicio;
                target.AnoFin = respaldo.AnoFin;
                target.NombreReconocimiento = respaldo.NombreReconocimiento;
                target.InstitucionOtorgante = respaldo.InstitucionOtorgante;
                target.MotivoOCategoria = respaldo.MotivoOCategoria;
                target.TipoParticipacion = respaldo.TipoParticipacion;
                target.EstadoActual = respaldo.EstadoActual;
                target.ArchivoEvidencia = respaldo.ArchivoEvidencia;
            }
            else
            {
                EgresadoModel.ReconocimientosAcademicos.Remove(copiaNuevo);
            }
            await OnNotificar.InvokeAsync("Error de conexión al guardar.");
        }
        finally
        {
            guardando = false;
        }
    }

    private void Cancelar()
    {
        errores.Clear();
        registroEnEdicion = null;
        nuevoRegistro = new ReconocimientoAcademico();
        fechaInicioTemp = null;
        fechaFinTemp = null;
        archivoSeleccionado = null;
        errorArchivo = null;
        mostrandoFormulario = false;
    }

    private async Task ConfirmarEliminar(ReconocimientoAcademico rec)
    {
        try
        {
            if (rec.IdReconomiento > 0)
            {
                await EgresadoService.EliminarReconocimientoAcademicoAsync(rec);
            }

            try
            {
                EvidenceStorage.Delete(rec.ArchivoEvidencia);
            }
            catch (IOException ex)
            {
                Console.WriteLine($"No se pudo eliminar el archivo de evidencia: {ex.Message}");
            }
            catch (UnauthorizedAccessException ex)
            {
                Console.WriteLine($"No hay permisos para eliminar el archivo de evidencia: {ex.Message}");
            }

            EgresadoModel.ReconocimientosAcademicos.Remove(rec);
            await OnNotificar.InvokeAsync("Registro eliminado.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar distinción: {ex.Message}");
            await OnNotificar.InvokeAsync("No se pudo eliminar el registro.");
        }
    }
}