@using System.Security.Claims
@using Follower.Models
@using Follower.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthStateProvider
@inject Follower.Data.ApplicationDbContext DbContext
@inject IEvidenciaPdfService EvidenciaPdfService

<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Evidencias y documentos</h1>
    <p class="text-gray-500">Comparte PDFs de títulos, constancias o certificaciones como respaldo de tu trayectoria.</p>
</div>

<section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-gray-900">Archivos PDF</h2>
    <p class="mt-1 text-sm text-gray-500">Cada archivo puede tener hasta 10 MB.</p>

    <div class="mt-5">
        <label for="evidencia-pdf" class="mb-2 block text-sm font-medium text-gray-700">Seleccionar documento</label>
        <InputFile id="evidencia-pdf"
                   OnChange="SubirArchivo"
                   accept=".pdf,application/pdf"
                   disabled="@(cargando || idEgresado <= 0 || !string.IsNullOrEmpty(archivoSeleccionado))"
                   class="block w-full text-sm text-gray-700 file:mr-4 file:rounded-md file:border-0 file:bg-blue-50 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-[#003366] hover:file:bg-blue-100" />
        @if (!string.IsNullOrWhiteSpace(archivoSeleccionado))
        {
            <p class="mt-2 text-sm text-gray-500">@archivoSeleccionado</p>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert">@error</p>
    }
    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <p class="mt-4 rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800" role="status">@mensaje</p>
    }

    <div class="mt-6 border-t border-gray-100 pt-5">
        <h3 class="text-sm font-semibold text-gray-900">Documentos compartidos</h3>
        @if (cargando)
        {
            <p class="mt-3 text-sm text-gray-500">Cargando documentos...</p>
        }
        else if (archivos.Count == 0)
        {
            <p class="mt-3 text-sm text-gray-500">Aún no has subido documentos.</p>
        }
        else
        {
            <ul class="mt-3 divide-y divide-gray-100">
                @foreach (var archivo in archivos)
                {
                    <li @key="archivo.Id" class="py-3">
                        <span class="break-all text-sm font-medium text-gray-900">@archivo.Nombre</span>
                        <span class="ml-2 text-xs text-gray-500">@($"{archivo.Tamano / 1024:N0} KB")</span>
                    </li>
                }
            </ul>
        }
    </div>
</section>

@code {
    private readonly List<EvidenciaPdf> archivos = new();
    private int idEgresado;
    private string? archivoSeleccionado;
    private string? error;
    private string? mensaje;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
            if (!int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var idUsuario))
            {
                error = "No fue posible identificar tu sesión.";
                return;
            }

            var egresado = await DbContext.Egresados
                .AsNoTracking()
                .FirstOrDefaultAsync(item => item.IdUsuario == idUsuario);
            if (egresado is null)
            {
                error = "No se encontró un perfil de egresado para esta cuenta.";
                return;
            }

            idEgresado = egresado.IdEgresado;
            await CargarArchivos();
        }
        catch (Exception)
        {
            error = "No fue posible cargar tus evidencias.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task SubirArchivo(InputFileChangeEventArgs eventArgs)
    {
        archivoSeleccionado = eventArgs.File.Name;
        error = null;
        mensaje = null;

        try
        {
            await EvidenciaPdfService.GuardarAsync(idEgresado, eventArgs.File);
            await CargarArchivos();
            mensaje = "El documento se subió correctamente y ya está disponible para el responsable de tu programa.";
        }
        catch (InvalidDataException ex)
        {
            error = ex.Message;
        }
        catch (IOException)
        {
            error = "No fue posible guardar el archivo. Intenta nuevamente.";
        }
        catch (Exception)
        {
            error = "Ocurrió un error al subir el documento.";
        }
        finally
        {
            archivoSeleccionado = null;
        }
    }

    private async Task CargarArchivos()
    {
        archivos.Clear();
        archivos.AddRange(await EvidenciaPdfService.ListarAsync(idEgresado));
    }
}
