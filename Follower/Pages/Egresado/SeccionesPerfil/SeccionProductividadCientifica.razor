@using Follower.Models
@using Follower.Services
@inject IEgresadoService EgresadoService

<div class="bg-white display-6 rounded-xl border border-gray-200  shadow-sm">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-lg font-bold text-gray-900">Productividad científica</h2>
        @if (!mostrandoFormulario)
        {
            <buton @onclick="() => mostrandoFormulario = true" class="text-sm font-medium text-[#003366] hover:underline">
                + Registrar producto
            </buton>
        }
    </div

    <!-- Productos guardados -->
    @if (EgresadoModel.ProductividadesCientificas.Any())
    {
        <div class="space-y-4 mb-6">
            @foreach (var prod in EgresadoModel.ProductividadesCientificas)
            {
                <div class="border border-gray-200 rounded-lg p-5 bg-white relative">
                    <div class="position-absolute rounded-top-4 right-5 flex-column space-x-3 text-[13px] font-medium text-slate-400">
                        <button class="hover:text-slate-600 transition-colors">Editar</button>
                    </div>
                </div>
                <h3 class="font-bold text-slate-900 text-lg mb-1 pr-32">@prod.Titulo</h3>
                <p class="text-xl-start text-[#003366] font-bold mb-1.5 uppercase">@prod.TipoProducto</p>
                
                <p class="text-sm text-slate-600 mb-4">
                    @(string.IsNullOrEmpty(prod.RevistaOLibro) ? prod.Editorial : prod.RevistaOLibro)
                    @if(prod.AnoPublicacion.HasValue) { <span>• @prod.AnoPublicacion </span>}
                </p>

                @if (prod.Coautores.Any() || (prod.ParticipoProfesorMied && !string.IsNullOrWhiteSpace(prod.NombreProfesorMied)))
                {
                    <div class ="border-t border-slate-100 pt-4 mt-2">
                        @if (prod.Coautores.Any())
                        {
                            <p class="text-[11px] font-bold text-slate-400 mb-2">COAUTORES RECONOCIDOS</p>
                            <ul class="text-sm text-slate-700 list-disc list-inside mb-3">
                                @foreach (var coautor in prod.Coautores)
                                {
                                    <li>@coautor.Nombres @coautor.ApellidoPaterno (@coautor.Rol) </li>
                                }
                            </ul>
                        }
                        @if (prod.ParticipoProfesorMied && !string.IsNullOrWhiteSpace(prod.NombreProfesorMied))
                        {
                            <div>
                                <p class="text-[11px] font-bold text-slate-400 mb-0.5">PROFESOR MIED PARTICIPANTE</p>
                                <p class="text-sm text-slate-800">@prod.NombreProfesorMied</p>
                            </div>
                        }
                    </div>
                }
            }
        </div>
        
    }
    else if (!mostrandoFormulario)
    {
        <p class="text-sm text-gray-500 mb-6 italic">No has registrado ninguna publicación o libro.</p>
    }

    <!-- Form nuevo producto -->
    @if (mostrandoFormulario)
    {
        <div class="border border-blue-100 bg-[#fbfdff] rounded-lg p-5">
            <h3 class="text-sm font-bold text-gray-900 mb-4 border-b pb-2">Registrar nueva publicación</h3>
            <div class="mb-4">
                <label class="block text-xs font-bold text-gray-700 mb-1">Tipo de producto</label>
                <select @bind="nuevoRegistro.TipoProducto" class="w-full border border-gray-300 rounded-md p-2 text-sm focus:ring-[#003366] bg-white">
                    <option value="">Seleccione el tipo de publicación...</option>
                    <option value="Artículo en revista indexada">Artículo publicado en revista indexada</option>
                    <option value="Artículo en revista arbitrada">Artículo publicado en revista arbitrada</option>
                    <option value="Capítulo de libro">Capítulo de libro publicado</option>
                    <option value="Libro">Libro publicado</option>
                </select>
            </div>


        </div>
    }

</div>
@code {
    public Egresado EgresadoModel { get; set; } = null!;
    public EventCallback<string> OnNotificar { get; set; }
    private bool mostrandoFormulario = false;
    private ProductividadCientifica nuevoRegistro = new ProductividadCientifica();
    private CoautorProducto tempCoautor = new CoautorProducto();

    private void AgregarCoautor()
    {
        if (!string.IsNullOrWhiteSpace(tempCoautor.Nombres) && !string.IsNullOrWhiteSpace(tempCoautor.ApellidoPaterno) && !string.IsNullOrWhiteSpace(tempCoautor.Rol))
        {
            nuevoRegistro.Coautores.Add(new CoautorProducto
            {
                Nombres = tempCoautor.Nombres,
                ApellidoPaterno = tempCoautor.ApellidoPaterno,
                Rol = tempCoautor.Rol
            });
            tempCoautor = new CoautorProducto();
        }
    }
    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(nuevoRegistro.Titulo))
        {
            await OnNotificar.InvokeAsync("El titulo es obligatorio.");
            return;
        }
        nuevoRegistro.EgresadoId = EgresadoModel.IdEgresado;
        EgresadoModel.ProductividadesCientificas.Add(nuevoRegistro);
        await EgresadoService.ActualizarAsync(EgresadoModel);
        nuevoRegistro = new ProductividadCientifica();
        mostrandoFormulario = false;
        await OnNotificar.InvokeAsync("Producto registrado exitosamente.");
    }

    private void Cancelar()
    {
        nuevoRegistro = new ProductividadCientifica();
        tempCoautor = new CoautorProducto();
        mostrandoFormulario = false;
    }

    private async Task ConfirmarEliminar (ProductividadCientifica prod)
    {
        if (prod.IdProductividad > 0)
        {
            EgresadoModel.ProductividadesCientificas.Remove(prod);
            await OnNotificar.InvokeAsync("Producto eliminado.");
        }
    }


}
