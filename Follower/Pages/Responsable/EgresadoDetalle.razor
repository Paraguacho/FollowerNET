@page "/responsable/egresados/{IdEgresado:int}"
@attribute [Authorize(Roles = "ResponsablePrograma")]
@using System.Globalization
@using Follower.Models
@using Follower.Services
@using Microsoft.AspNetCore.Authorization
@inject IEgresadosBusquedaService EgresadosBusquedaService

<div class="min-h-screen bg-gray-50 font-sans">
	<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
		<a href="/responsable/egresados" class="text-sm font-semibold text-[#003366] hover:underline">&larr; Volver a egresados</a>

		@if (cargando)
		{
			<div class="mt-6 rounded-xl border border-gray-200 bg-white p-12 text-center text-gray-500">Cargando perfil...</div>
		}
		else if (!string.IsNullOrWhiteSpace(error))
		{
			<div class="mt-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">@error</div>
		}
		else if (egresado is not null)
		{
			<header class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
				<p class="text-sm font-semibold uppercase tracking-wider text-[#003366]">Perfil de egresado</p>
				<h1 class="mt-1 text-3xl font-bold text-gray-900">@egresado.Nombres @egresado.ApellidoPaterno @egresado.ApellidoMaterno</h1>
				<p class="mt-2 text-sm text-gray-500">Última actualización: @FormatearFecha(egresado.FechaUltimaActualizacion)</p>
			</header>

			<section class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
				<h2 class="text-xl font-bold text-gray-900">Información general</h2>
				<dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					<div><dt class="text-sm text-gray-500">Año de egreso</dt><dd class="mt-1 font-medium text-gray-900">@(egresado.FechaEgreso?.ToString() ?? "Sin registro")</dd></div>
					<div><dt class="text-sm text-gray-500">Teléfono</dt><dd class="mt-1 font-medium text-gray-900">@(egresado.Telefono ?? "Sin registro")</dd></div>
					<div><dt class="text-sm text-gray-500">Ciudad</dt><dd class="mt-1 font-medium text-gray-900">@(egresado.Ciudad ?? "Sin registro")</dd></div>
					<div><dt class="text-sm text-gray-500">Estado</dt><dd class="mt-1 font-medium text-gray-900">@(egresado.Estado ?? "Sin registro")</dd></div>
					<div><dt class="text-sm text-gray-500">País</dt><dd class="mt-1 font-medium text-gray-900">@(egresado.Pais ?? "Sin registro")</dd></div>
				</dl>
				@if (egresado.PerfilAcademico is not null)
				{
					<div class="mt-5 border-t border-gray-100 pt-4">
						<h3 class="font-semibold text-gray-900">Perfiles académicos</h3>
						<dl class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
							@if (!string.IsNullOrWhiteSpace(egresado.PerfilAcademico.Orcid)) { <div><dt class="text-sm text-gray-500">ORCID</dt><dd class="break-all text-sm text-gray-900">@egresado.PerfilAcademico.Orcid</dd></div> }
							@if (!string.IsNullOrWhiteSpace(egresado.PerfilAcademico.GoogleScholar)) { <div><dt class="text-sm text-gray-500">Google Scholar</dt><dd class="break-all text-sm text-gray-900">@egresado.PerfilAcademico.GoogleScholar</dd></div> }
							@if (!string.IsNullOrWhiteSpace(egresado.PerfilAcademico.ResearchGate)) { <div><dt class="text-sm text-gray-500">ResearchGate</dt><dd class="break-all text-sm text-gray-900">@egresado.PerfilAcademico.ResearchGate</dd></div> }
							@if (!string.IsNullOrWhiteSpace(egresado.PerfilAcademico.AcademiaEdu)) { <div><dt class="text-sm text-gray-500">Academia.edu</dt><dd class="break-all text-sm text-gray-900">@egresado.PerfilAcademico.AcademiaEdu</dd></div> }
							@if (!string.IsNullOrWhiteSpace(egresado.PerfilAcademico.ScopusId)) { <div><dt class="text-sm text-gray-500">Scopus ID</dt><dd class="break-all text-sm text-gray-900">@egresado.PerfilAcademico.ScopusId</dd></div> }
							@if (!string.IsNullOrWhiteSpace(egresado.PerfilAcademico.LinkedIn)) { <div><dt class="text-sm text-gray-500">LinkedIn</dt><dd class="break-all text-sm text-gray-900">@egresado.PerfilAcademico.LinkedIn</dd></div> }
						</dl>
					</div>
				}
			</section>

			<section class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
				<h2 class="text-xl font-bold text-gray-900">Situación y experiencia laboral</h2>
				<p class="mt-3 text-sm text-gray-700"><span class="font-semibold">Situación actual:</span> @(egresado.SituacionLaboral?.EstadoActual ?? "Sin registro")</p>
				@if (egresado.ExperienciasLaborales.Count > 0)
				{
					<div class="mt-4 space-y-4">
						@foreach (var experiencia in egresado.ExperienciasLaborales.OrderByDescending(x => x.EsEmpleoActual).ThenByDescending(x => x.FechaInicio))
						{
							<article class="rounded-lg border border-gray-200 p-4">
								<h3 class="font-semibold text-gray-900">@experiencia.Puesto · @experiencia.Institucion</h3>
								<p class="mt-1 text-sm text-gray-600">@(experiencia.Sector ?? "Sector sin registro") · @(experiencia.EsEmpleoActual ? "Empleo actual" : "Experiencia anterior")</p>
								<p class="mt-1 text-sm text-gray-600">@FormatearFecha(experiencia.FechaInicio) – @FormatearFecha(experiencia.FechaFin)</p>
								@if (!string.IsNullOrWhiteSpace(experiencia.RelacionConFormacion)) { <p class="mt-2 text-sm text-gray-700">Relación con su formación: @experiencia.RelacionConFormacion</p> }
								@if (!string.IsNullOrWhiteSpace(experiencia.ActividadesPrincipales)) { <p class="mt-2 whitespace-pre-line text-sm text-gray-700">@experiencia.ActividadesPrincipales</p> }
							</article>
						}
					</div>
				}
				else
				{
					<p class="mt-3 text-sm text-gray-500">Sin experiencias laborales registradas.</p>
				}
			</section>

			<section class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
				<h2 class="text-xl font-bold text-gray-900">Formación académica</h2>
				@if (egresado.FormacionesAcademicas.Count > 0)
				{
					<div class="mt-4 space-y-4">
						@foreach (var formacion in egresado.FormacionesAcademicas.OrderByDescending(x => x.EsFormacionActual).ThenByDescending(x => x.FechaInicio))
						{
							<article class="rounded-lg border border-gray-200 p-4">
								<h3 class="font-semibold text-gray-900">@formacion.NombrePrograma</h3>
								<p class="mt-1 text-sm text-gray-600">@(formacion.Grado ?? "Grado sin registro") · @(formacion.Institucion ?? "Institución sin registro")</p>
								<p class="mt-1 text-sm text-gray-600">@(formacion.EstadoPrograma ?? "Estado sin registro"), @(formacion.Pais ?? "País sin registro") · @FormatearFecha(formacion.FechaInicio) – @FormatearFecha(formacion.FechaFin)</p>
								@if (formacion.EsFormacionActual) { <p class="mt-2 text-sm font-semibold text-[#003366]">Formación actual</p> }
								@if (formacion.RecibioBeca) { <p class="mt-1 text-sm text-gray-700">Apoyo: @(formacion.TipoApoyo ?? "Beca") · @(formacion.InstitucionOtorgante ?? "Institución otorgante sin registro")</p> }
							</article>
						}
					</div>
				}
				else
				{
					<p class="mt-3 text-sm text-gray-500">Sin formaciones académicas registradas.</p>
				}
			</section>

			@if (egresado.ValoresCamposPersonalizados.Count > 0)
			{
				<section class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
					<h2 class="text-xl font-bold text-gray-900">Datos adicionales del programa</h2>
					<dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
						@foreach (var valor in egresado.ValoresCamposPersonalizados.OrderBy(x => x.CampoPersonalizado.SeccionPersonalizada.OrdenAparicion).ThenBy(x => x.CampoPersonalizado.Orden))
						{
							<div><dt class="text-sm text-gray-500">@valor.CampoPersonalizado.SeccionPersonalizada.TituloSeccion · @valor.CampoPersonalizado.NombreEtiqueta</dt><dd class="mt-1 whitespace-pre-line font-medium text-gray-900">@(valor.ValorCapturado ?? "Sin registro")</dd></div>
						}
					</dl>
				</section>
			}

			@if (egresado.ProductividadesCientificas.Count > 0)
			{
				<section class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
					<h2 class="text-xl font-bold text-gray-900">Productividad científica</h2>
					<div class="mt-4 space-y-4">
						@foreach (var producto in egresado.ProductividadesCientificas.OrderByDescending(x => x.AnoPublicacion))
						{
							<article class="rounded-lg border border-gray-200 p-4">
								<h3 class="font-semibold text-gray-900">@producto.Titulo</h3>
								<p class="mt-1 text-sm text-gray-600">@producto.TipoProducto · @(producto.AnoPublicacion?.ToString() ?? "Año sin registro")</p>
								<p class="mt-1 text-sm text-gray-600">@(producto.RevistaOLibro ?? producto.Editorial ?? "Publicación sin registro") · @(producto.Participacion ?? "Participación sin registro")</p>
								@if (producto.Coautores.Count > 0) { <p class="mt-2 text-sm text-gray-700">Coautores: @string.Join(", ", producto.Coautores.Select(x => $"{x.Nombres} {x.ApellidoPaterno} {x.ApellidoMaterno}".Trim()))</p> }
							</article>
						}
					</div>
				</section>
			}

			@if (egresado.ProyectosInvestigacion.Count > 0)
			{
				<section class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
					<h2 class="text-xl font-bold text-gray-900">Proyectos de investigación</h2>
					<div class="mt-4 space-y-4">
						@foreach (var proyecto in egresado.ProyectosInvestigacion)
						{
							<article class="rounded-lg border border-gray-200 p-4">
								<h3 class="font-semibold text-gray-900">@proyecto.Nombre</h3>
								<p class="mt-1 text-sm text-gray-600">@proyecto.Institucion · @proyecto.Periodo</p>
								<p class="mt-1 text-sm text-gray-600">@proyecto.Funcion · @proyecto.Estado</p>
							</article>
						}
					</div>
				</section>
			}

			@if (egresado.ReconocimientosAcademicos.Count > 0)
			{
				<section class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
					<h2 class="text-xl font-bold text-gray-900">Reconocimientos académicos</h2>
					<div class="mt-4 space-y-4">
						@foreach (var reconocimiento in egresado.ReconocimientosAcademicos.OrderByDescending(x => x.AnoFin))
						{
							<article class="rounded-lg border border-gray-200 p-4">
								<h3 class="font-semibold text-gray-900">@(reconocimiento.NombreReconocimiento ?? reconocimiento.TipoRegistro)</h3>
								<p class="mt-1 text-sm text-gray-600">@reconocimiento.TipoRegistro · @(reconocimiento.Nivel ?? "Nivel sin registro") · @reconocimiento.AnoFin</p>
								<p class="mt-1 text-sm text-gray-600">@(reconocimiento.InstitucionOtorgante ?? "Institución sin registro") · @(reconocimiento.MotivoOCategoria ?? "Sin categoría")</p>
							</article>
						}
					</div>
				</section>
			}

			@if (egresado.ContribucionesSociales.Count > 0)
			{
				<section class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
					<h2 class="text-xl font-bold text-gray-900">Contribuciones sociales</h2>
					<div class="mt-4 space-y-4">
						@foreach (var contribucion in egresado.ContribucionesSociales)
						{
							<article class="rounded-lg border border-gray-200 p-4">
								<h3 class="font-semibold text-gray-900">@contribucion.NombreActividad</h3>
								<p class="mt-1 text-sm text-gray-600">@contribucion.TipoContribucion · Sector atendido: @contribucion.SectorAtendido</p>
								<p class="mt-2 whitespace-pre-line text-sm text-gray-700">@contribucion.Descripcion</p>
								@if (!string.IsNullOrWhiteSpace(contribucion.Resultados)) { <p class="mt-2 whitespace-pre-line text-sm text-gray-700"><span class="font-semibold">Resultados:</span> @contribucion.Resultados</p> }
							</article>
						}
					</div>
				</section>
			}
		}
	</div>
</div>

@code {
	[Parameter]
	public int IdEgresado { get; set; }

	private Egresado? egresado;
	private string? error;
	private bool cargando = true;

	// HU3.3
	// Flujo: toma el ID de la ruta, solicita el perfil dentro del alcance autorizado y prepara estados de carga o error.
	// Función: presenta de forma segura el detalle del egresado seleccionado.
	protected override async Task OnParametersSetAsync()
	{
		cargando = true;
		error = null;
		try
		{
			egresado = await EgresadosBusquedaService.ObtenerPerfilAutorizadoAsync(IdEgresado);
			if (egresado is null)
			{
				error = "No se encontró el perfil solicitado dentro de tu programa autorizado.";
			}
		}
		catch (UnauthorizedAccessException ex)
		{
			error = ex.Message;
		}
		catch
		{
			error = "No se pudo cargar el perfil solicitado.";
		}
		finally
		{
			cargando = false;
		}
	}

	// HU3.3
	// Flujo: convierte una fecha opcional a la zona local y sustituye los valores nulos por texto de respaldo.
	// Función: formatea fechas de secciones del perfil.
	private static string FormatearFecha(DateTime? fecha) =>
		fecha?.ToLocalTime().ToString("dd MMM yyyy", CultureInfo.CurrentCulture) ?? "Sin registro";

	// HU3.3
	// Flujo: convierte la fecha obligatoria a la zona local y al formato de presentación.
	// Función: formatea la fecha de última actualización del perfil.
	private static string FormatearFecha(DateTime fecha) =>
		fecha.ToLocalTime().ToString("dd MMM yyyy", CultureInfo.CurrentCulture);
}
