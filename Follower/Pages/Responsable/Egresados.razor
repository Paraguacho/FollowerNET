@page "/responsable/egresados"
@attribute [Authorize(Roles = "ResponsablePrograma")]
@using System.Globalization
@using Follower.DTOs
@using Microsoft.AspNetCore.Authorization
@using Follower.Services
@inject IEgresadosBusquedaService EgresadosBusquedaService

<div class="min-h-screen bg-gray-50 font-sans">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8">
            <p class="text-sm font-semibold uppercase tracking-wider text-[#003366]">Gestión de egresados</p>
            <h1 class="mt-1 text-3xl font-bold text-gray-900">Buscar egresados</h1>
            <p class="mt-2 text-sm text-gray-500">Consulta los perfiles autorizados de tu programa educativo.</p>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">@error</div>
        }
        else if (cargando)
        {
            <div class="rounded-xl border border-gray-200 bg-white p-12 text-center text-gray-500">Cargando egresados...</div>
        }
        else
        {
            <section class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
                <div class="flex flex-col gap-3 xl:flex-row xl:items-center">
                    <div class="relative flex-1">
                        <svg class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
                        </svg>
                        <input @bind="filtros.TerminoBusqueda" @bind:event="oninput" @onkeydown="ManejarTecla"
                               class="w-full rounded-lg border border-gray-300 py-3 pl-10 pr-10 text-sm text-gray-900 outline-none transition focus:border-[#003366] focus:ring-2 focus:ring-blue-100"
                               placeholder="Buscar por nombre o apellidos..." aria-label="Buscar egresados" />
                        @if (!string.IsNullOrWhiteSpace(filtros.TerminoBusqueda))
                        {
                            <button type="button" @onclick="LimpiarBusquedaAsync" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700" aria-label="Limpiar búsqueda">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 6 12 12M18 6 6 18" /></svg>
                            </button>
                        }
                    </div>
                    <button type="button" @onclick="AplicarBusquedaAsync" class="rounded-lg bg-[#003366] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#002244]">Buscar</button>
                    <button type="button" @onclick="AlternarFiltros" class="flex items-center justify-center gap-2 rounded-lg border border-gray-300 px-5 py-3 text-sm font-semibold text-gray-700 transition hover:bg-gray-50" aria-expanded="@mostrandoFiltros">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm0-12v2m0 13v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg>
                        Filtros @(mostrandoFiltros ? "−" : "+")
                    </button>
                    <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">
                        <input type="checkbox" @bind="filtros.SoloDesactualizados" @bind:after="AplicarFiltrosAsync" class="h-4 w-4 accent-red-600" />
                        Perfiles desactualizados (&gt; 12 meses)
                    </label>
                </div>

                @if (mostrandoFiltros)
                {
                    <div class="mt-5 grid gap-4 border-t border-gray-200 pt-5 sm:grid-cols-2 xl:grid-cols-4">
                        <label class="text-sm font-medium text-gray-700">
                            Situación laboral actual
                            <select @bind="filtros.SituacionLaboral" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2">
                                <option value="">Todas</option>
                                @foreach (var situacion in opciones.SituacionesLaborales)
                                {
                                    <option value="@situacion">@situacion</option>
                                }
                            </select>
                        </label>
                        <label class="text-sm font-medium text-gray-700">
                            Sector de empleo actual
                            <select @bind="filtros.Sector" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2">
                                <option value="">Todos</option>
                                @foreach (var sector in opciones.Sectores)
                                {
                                    <option value="@sector">@sector</option>
                                }
                            </select>
                        </label>
                        <label class="text-sm font-medium text-gray-700">
                            Nivel de estudio actual
                            <select @bind="filtros.NivelEstudioActual" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2">
                                <option value="">Todos</option>
                                @foreach (var nivel in opciones.NivelesEstudio)
                                {
                                    <option value="@nivel">@nivel</option>
                                }
                            </select>
                        </label>
                        <label class="text-sm font-medium text-gray-700">
                            Año de egreso desde
                            <input type="number" @bind="filtros.AnioEgresoDesde" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" />
                        </label>
                        <label class="text-sm font-medium text-gray-700">
                            Año de egreso hasta
                            <input type="number" @bind="filtros.AnioEgresoHasta" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" />
                        </label>
                        <label class="text-sm font-medium text-gray-700">
                            Institución actual
                            <input @bind="filtros.InstitucionActual" @bind:event="oninput" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" placeholder="Buscar institución" />
                        </label>
                        <label class="text-sm font-medium text-gray-700">
                            Ciudad
                            <input @bind="filtros.Ciudad" @bind:event="oninput" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" placeholder="Buscar ciudad" />
                        </label>
                        <label class="text-sm font-medium text-gray-700">
                            Estado
                            <input @bind="filtros.Estado" @bind:event="oninput" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" placeholder="Buscar estado" />
                        </label>
                        <label class="text-sm font-medium text-gray-700">
                            País
                            <input @bind="filtros.Pais" @bind:event="oninput" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2" placeholder="Buscar país" />
                        </label>
                        <div class="flex items-end gap-3 xl:col-span-4">
                            <button type="button" @onclick="AplicarFiltrosAsync" disabled="@buscando" class="rounded-lg bg-[#003366] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#002244] disabled:opacity-50">Aplicar filtros</button>
                            <button type="button" @onclick="LimpiarTodosLosFiltrosAsync" disabled="@buscando" class="rounded-lg border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 disabled:opacity-50">Limpiar todos los filtros</button>
                        </div>
                    </div>
                }

                @if (FiltrosActivos.Count > 0)
                {
                    <div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-gray-500">
                        <span>Filtros activos</span>
                        @foreach (var filtroActivo in FiltrosActivos)
                        {
                            <span class="rounded-full bg-blue-100 px-3 py-1 font-medium text-[#003366]">@filtroActivo</span>
                        }
                        <button type="button" @onclick="LimpiarTodosLosFiltrosAsync" class="font-semibold text-[#003366] hover:underline">Limpiar todos</button>
                    </div>
                }
            </section>

            <section class="mt-6">
                @if (totalResultados == 0)
                {
                    <div class="rounded-xl border border-gray-200 bg-gray-100 px-6 py-16 text-center">
                        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white text-gray-400">
                            <svg class="h-9 w-9" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-5.5-2.5 3 3m0-3-3 3" /></svg>
                        </div>
                        <h2 class="mt-5 text-lg font-bold text-gray-900">No se encontraron egresados que coincidan con los criterios seleccionados</h2>
                        <p class="mx-auto mt-2 max-w-xl text-sm text-gray-500">Revisa los criterios de búsqueda o limpia los filtros para volver a mostrar los egresados de @SiglasPrograma.</p>
                        <button type="button" @onclick="LimpiarTodosLosFiltrosAsync" class="mt-6 rounded-lg bg-[#003366] px-5 py-3 text-sm font-semibold text-white hover:bg-[#002244]">Limpiar todos los filtros</button>
                        <p class="mt-3 text-xs text-gray-500">Se mostrarán todos los egresados de tu programa autorizado.</p>
                    </div>
                }
                else
                {
                    <div class="mb-4">
                        <h2 class="text-xl font-bold text-gray-900">Mostrando @totalResultados resultados</h2>
                        <p class="mt-1 text-sm text-gray-500">@(FiltrosActivos.Count == 0 ? "Todos los egresados" : "Resultados según los criterios seleccionados") • Todos los perfiles pertenecen a @SiglasPrograma.</p>
                        @if (buscando)
                        {
                            <p class="mt-1 text-xs text-gray-500" role="status">Actualizando resultados...</p>
                        }
                    </div>
                    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-5 py-4 text-left text-xs font-bold tracking-wider text-gray-500"><button @onclick="() => OrdenarPorAsync(EgresadosOrdenCampo.Nombre)">NOMBRE COMPLETO @IconoOrden(EgresadosOrdenCampo.Nombre)</button></th>
                                        <th class="px-5 py-4 text-left text-xs font-bold tracking-wider text-gray-500"><button @onclick="() => OrdenarPorAsync(EgresadosOrdenCampo.FechaEgreso)">GENERACIÓN / AÑO DE TITULACIÓN @IconoOrden(EgresadosOrdenCampo.FechaEgreso)</button></th>
                                        <th class="px-5 py-4 text-left text-xs font-bold tracking-wider text-gray-500"><button @onclick="() => OrdenarPorAsync(EgresadosOrdenCampo.SituacionLaboral)">SITUACIÓN LABORAL ACTUAL @IconoOrden(EgresadosOrdenCampo.SituacionLaboral)</button></th>
                                        <th class="px-5 py-4 text-left text-xs font-bold tracking-wider text-gray-500"><button @onclick="() => OrdenarPorAsync(EgresadosOrdenCampo.FechaUltimaActualizacion)">FECHA DE ÚLTIMA ACTUALIZACIÓN @IconoOrden(EgresadosOrdenCampo.FechaUltimaActualizacion)</button></th>
                                        <th class="px-5 py-4 text-left text-xs font-bold tracking-wider text-gray-500">ACCIÓN</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    @foreach (var egresado in resultadosPagina)
                                    {
                                        <tr @key="egresado.IdEgresado" class="hover:bg-gray-50">
                                            <td class="whitespace-nowrap px-5 py-4"><div class="font-semibold text-gray-900">@egresado.Nombres @egresado.ApellidoPaterno @egresado.ApellidoMaterno</div></td>
                                            <td class="px-5 py-4 text-sm text-gray-700">@(egresado.FechaEgreso?.ToString() ?? "Sin registro")</td>
                                            <td class="px-5 py-4 text-sm text-gray-700">@(egresado.SituacionLaboral ?? "Sin registro")</td>
                                            <td class="whitespace-nowrap px-5 py-4 text-sm text-gray-700">@egresado.FechaUltimaActualizacion.ToLocalTime().ToString("dd MMM yyyy", CultureInfo.CurrentCulture)</td>
                                            <td class="px-5 py-4"><a href="@($"/responsable/egresados/{egresado.IdEgresado}")" class="text-sm font-semibold text-[#003366] hover:underline">Ver perfil &gt;</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="flex flex-col gap-4 border-t border-gray-200 px-5 py-4 text-sm text-gray-600 sm:flex-row sm:items-center sm:justify-between">
                            <span>@PrimerResultado-@UltimoResultado de @totalResultados resultados</span>
                            <div class="flex items-center gap-4">
                                <label>Registros por página <select @bind="filtros.RegistrosPorPagina" @bind:after="CambiarRegistrosPorPaginaAsync" class="ml-2 rounded border border-gray-300 px-2 py-1"><option value="10">10</option><option value="20">20</option><option value="50">50</option></select></label>
                                <div class="flex items-center gap-2"><button @onclick="PaginaAnteriorAsync" disabled="@(filtros.Pagina == 1 || buscando)" class="rounded border border-gray-300 px-3 py-1 disabled:opacity-40">&lt;</button><span>@filtros.Pagina / @TotalPaginas</span><button @onclick="PaginaSiguienteAsync" disabled="@(filtros.Pagina >= TotalPaginas || buscando)" class="rounded border border-gray-300 px-3 py-1 disabled:opacity-40">&gt;</button></div>
                            </div>
                        </div>
                    </div>
                }
            </section>
        }
    </div>
</div>

@code {
    private EgresadosBusquedaFiltrosDto filtros = new();
    private EgresadosBusquedaFiltrosDto filtrosAplicados = new();
    private EgresadosBusquedaOpcionesDto opciones = new();
    private IReadOnlyList<EgresadosBusquedaFilaDto> resultadosPagina = Array.Empty<EgresadosBusquedaFilaDto>();
    private string? error;
    private bool cargando = true;
    private bool buscando;
    private bool mostrandoFiltros;
    private long totalResultados;

    private string SiglasPrograma => string.IsNullOrWhiteSpace(opciones.SiglasPrograma) ? "MIED" : opciones.SiglasPrograma;
    private int TotalPaginas => totalResultados == 0
        ? 1
        : (int)Math.Min(int.MaxValue, (totalResultados - 1) / filtros.RegistrosPorPagina + 1);
    private long PrimerResultado => totalResultados == 0 ? 0 : (long)(filtros.Pagina - 1) * filtros.RegistrosPorPagina + 1;
    private long UltimoResultado => Math.Min((long)filtros.Pagina * filtros.RegistrosPorPagina, totalResultados);
    private IReadOnlyList<string> FiltrosActivos => ObtenerFiltrosActivos();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            opciones = await EgresadosBusquedaService.ObtenerOpcionesAsync();
            await CargarResultadosAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            error = ex.Message;
        }
        catch
        {
            error = "No se pudieron cargar las opciones de búsqueda.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarResultadosAsync(bool reiniciarPagina = false)
    {
        if (reiniciarPagina)
        {
            filtros.Pagina = 1;
        }
        buscando = true;
        error = null;
        try
        {
            var pagina = await EgresadosBusquedaService.BuscarAsync(filtros);
            resultadosPagina = pagina.Resultados;
            totalResultados = pagina.TotalResultados;
            filtros.Pagina = pagina.Pagina;
            filtros.RegistrosPorPagina = pagina.RegistrosPorPagina;
            CopiarFiltrosAplicados();
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            error = ex.Message;
        }
        catch
        {
            error = "No se pudieron cargar los egresados. Intenta de nuevo.";
        }
        finally
        {
            buscando = false;
            cargando = false;
        }
    }

    private async Task ManejarTecla(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await AplicarBusquedaAsync();
        }
    }

    private Task AplicarBusquedaAsync() => CargarResultadosAsync(reiniciarPagina: true);

    private Task AplicarFiltrosAsync() => CargarResultadosAsync(reiniciarPagina: true);

    private async Task LimpiarBusquedaAsync()
    {
        filtros.TerminoBusqueda = string.Empty;
        await AplicarBusquedaAsync();
    }

    private async Task LimpiarTodosLosFiltrosAsync()
    {
        filtros.TerminoBusqueda = null;
        filtros.AnioEgresoDesde = null;
        filtros.AnioEgresoHasta = null;
        filtros.SituacionLaboral = null;
        filtros.Sector = null;
        filtros.NivelEstudioActual = null;
        filtros.InstitucionActual = null;
        filtros.Ciudad = null;
        filtros.Estado = null;
        filtros.Pais = null;
        filtros.SoloDesactualizados = false;
        await CargarResultadosAsync(reiniciarPagina: true);
    }

    private void AlternarFiltros() => mostrandoFiltros = !mostrandoFiltros;

    private async Task OrdenarPorAsync(EgresadosOrdenCampo campo)
    {
        if (filtros.OrdenarPor == campo)
        {
            filtros.OrdenAscendente = !filtros.OrdenAscendente;
        }
        else
        {
            filtros.OrdenarPor = campo;
            filtros.OrdenAscendente = true;
        }

        await CargarResultadosAsync();
    }

    private string IconoOrden(EgresadosOrdenCampo campo)
    {
        if (filtros.OrdenarPor != campo)
        {
            return "↕";
        }

        return filtros.OrdenAscendente ? "↑" : "↓";
    }

    private Task CambiarRegistrosPorPaginaAsync() => CargarResultadosAsync(reiniciarPagina: true);

    private async Task PaginaAnteriorAsync()
    {
        if (filtros.Pagina > 1)
        {
            filtros.Pagina--;
            await CargarResultadosAsync();
        }
    }

    private async Task PaginaSiguienteAsync()
    {
        if (filtros.Pagina < TotalPaginas)
        {
            filtros.Pagina++;
            await CargarResultadosAsync();
        }
    }

    private void CopiarFiltrosAplicados()
    {
        filtrosAplicados.TerminoBusqueda = filtros.TerminoBusqueda;
        filtrosAplicados.AnioEgresoDesde = filtros.AnioEgresoDesde;
        filtrosAplicados.AnioEgresoHasta = filtros.AnioEgresoHasta;
        filtrosAplicados.SituacionLaboral = filtros.SituacionLaboral;
        filtrosAplicados.Sector = filtros.Sector;
        filtrosAplicados.NivelEstudioActual = filtros.NivelEstudioActual;
        filtrosAplicados.InstitucionActual = filtros.InstitucionActual;
        filtrosAplicados.Ciudad = filtros.Ciudad;
        filtrosAplicados.Estado = filtros.Estado;
        filtrosAplicados.Pais = filtros.Pais;
        filtrosAplicados.SoloDesactualizados = filtros.SoloDesactualizados;
    }

    private IReadOnlyList<string> ObtenerFiltrosActivos()
    {
        var activos = new List<string>();
        if (!string.IsNullOrWhiteSpace(filtrosAplicados.TerminoBusqueda)) activos.Add($"Nombre: {filtrosAplicados.TerminoBusqueda}");
        if (filtrosAplicados.AnioEgresoDesde.HasValue || filtrosAplicados.AnioEgresoHasta.HasValue)
            activos.Add($"Año de egreso: {filtrosAplicados.AnioEgresoDesde?.ToString() ?? "…"}–{filtrosAplicados.AnioEgresoHasta?.ToString() ?? "…"}");
        if (!string.IsNullOrWhiteSpace(filtrosAplicados.SituacionLaboral)) activos.Add($"Situación laboral: {filtrosAplicados.SituacionLaboral}");
        if (!string.IsNullOrWhiteSpace(filtrosAplicados.Sector)) activos.Add($"Sector: {filtrosAplicados.Sector}");
        if (!string.IsNullOrWhiteSpace(filtrosAplicados.NivelEstudioActual)) activos.Add($"Nivel de estudio: {filtrosAplicados.NivelEstudioActual}");
        if (!string.IsNullOrWhiteSpace(filtrosAplicados.InstitucionActual)) activos.Add($"Institución: {filtrosAplicados.InstitucionActual}");
        if (!string.IsNullOrWhiteSpace(filtrosAplicados.Ciudad)) activos.Add($"Ciudad: {filtrosAplicados.Ciudad}");
        if (!string.IsNullOrWhiteSpace(filtrosAplicados.Estado)) activos.Add($"Estado: {filtrosAplicados.Estado}");
        if (!string.IsNullOrWhiteSpace(filtrosAplicados.Pais)) activos.Add($"País: {filtrosAplicados.Pais}");
        if (filtrosAplicados.SoloDesactualizados) activos.Add("Perfiles desactualizados (> 12 meses)");
        return activos;
    }
}
