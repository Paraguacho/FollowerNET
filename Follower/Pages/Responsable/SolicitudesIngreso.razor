@page "/responsable/solicitudes"
@using Microsoft.EntityFrameworkCore
@using Follower.Models
@inject Follower.Data.ApplicationDbContext DbContext

<div class="min-h-screen bg-gray-50 flex flex-col font-sans">
    <!--  Componente "Solicitudes" -->


    <Follower.Shared.NavBarResponsable MenuActivo="Solicitudes" />
    <div class="flex flex-1 overflow-hidden">

        <!-- Sidebar Solicitudes -->
        <aside class="w-64 bg-white border-r border-gray-200 flex flex-col z-10 shrink-0">
            <div class="p-6 border-b border-gray-200">
                @if (programaActual != null)
                {
                    <h2 class="text-lg font-bold text-gray-900">@programaActual.Siglas</h2>
                    <h2 p class="text-xs text-gray-500 mt-1">@programaActual.NombrePrograma</h2>
                }
                else
                {
                    <h2 class="text-lg font-bold text-gray-900 text-gray-400">Cargando...</h2>
                }
            </div>
            <div class="p-4">
                <p class="text-xs font-semibold text-gray-400 tracking-wider mb-3">REVISIÓN DE ACCESOS</p>
                <div class="flex items-center justify-between p-2 bg-blue-50 border-l-4 border-[#003366] rounded-r cursor-pointer">
                    <div class="flex items-center space-x-3">
                        <svg class="w-5 h-5 text-[#003366]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                        <span class="text-sm font-medium text-[#003366]">Solicitudes pendientes</span>
                    </div>
                    <span class="bg-[#003366] text-white text-xs py-0.5 px-2 rounded-full">@pendientes.Count</span>
                </div>
            </div>
        </aside>

        <!-- area Derecha (Cabecera ContenidoDividido) -->
        <div class="flex-1 flex flex-col overflow-hidden">

            <!-- Cabecera -->
            <div class="px-8 py-6 border-b border-gray-200 bg-white shrink-0">
                <h1 class="text-2xl font-bold text-gray-900">Autorización de registros</h1>
                <p class="text-sm text-gray-500 mt-1">Revisa y valida las identidades de los usuarios que solicitan acceso a la plataforma.</p>
            </div>

            <!-- Contenedor lista y detalle -->
            <div class="flex flex-1 overflow-hidden">

                <!-- Lista pendientes -->
                <div class="w-80 bg-white border-r border-gray-200 flex flex-col shrink-0">
                    <div class="p-4 border-b border-gray-200 flex justify-between items-center">
                        <h3 class="text-sm font-bold text-gray-900">@pendientes.Count Pendientes <span class="inline-block w-2 h-2 rounded-full bg-yellow-400 ml-1"></span></h3>
                        <button class="text-xs border border-gray-300 rounded px-2 py-1 flex items-center text-gray-600 hover:bg-gray-50">
                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
                            Filtros
                        </button>
                    </div>

                    <div class="overflow-y-auto flex-1">
                        @if (!pendientes.Any())
                        {
                            <div class="p-6 text-center text-sm text-gray-500">No hay solicitudes pendientes.</div>
                        }

                        @foreach (var egresado in pendientes)
                        {
                            var isSelected = egresadoSeleccionado?.IdEgresado == egresado.IdEgresado;
                            <div @key egresado.IdEgresado"
                                @onclick="() => SeleccionarEgresado(egresado)"
                                    class="p-4 border-b border-gray-100 cursor-pointer transition-colors @(isSelected ? "bg-blue-50/50 border-l-4 border-l-[#003366]" : "hover:bg-gray-50 border-l-4 border-l-transparent")">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <h4 class="text-sm font-bold text-gray-900">@egresado.ApellidoPaterno @egresado.ApellidoMaterno, @egresado.Nombres</h4>
                                        <p class="text-xs text-gray-500 mt-1">Año de egreso: @(egresado.FechaEgreso?.ToString() ?? "N/A")</p>
                                        <p class="text-xs text-gray-400 mt-1 flex items-center">
                                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                            @egresado.FechaSolicitud?.ToString("dd MMM yyyy, HH:mm") hrs
                                        </p>
                                    </div>
                                    @if (isSelected)
                                    {
                                        <span class="bg-yellow-100 text-yellow-800 text-[10px] px-2 py-0.5 rounded font-medium">Nuevo</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                 <!-- Detalles Solicitud -->
                <main class="flex-1 bg-gray-50 overflow-y-auto p-8">
                    <div class="max-w-3xl mx-auto">
                        @if (egresadoSeleccionado != null)
                        {
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                                <!-- Encabezado Perfil -->
                                <div class="p-6 border-b border-gray-100 flex items-center space-x-4">
                                    <div class="h-14 w-14 rounded-full bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-xl">
                                        @egresadoSeleccionado.Nombres[0]@egresadoSeleccionado.ApellidoPaterno[0]
                                    </div>
                                    <div>
                                        <h2 class="text-xl font-bold text-gray-900">@egresadoSeleccionado.Nombres @egresadoSeleccionado.ApellidoPaterno @egresadoSeleccionado.ApellidoMaterno</h2>
                                        <p class="text-sm text-gray-500">Aspirante a registro en plataforma</p>
                                    </div>
                                </div>

                                <div class="p-6 space-y-6">
                                    <h3 class="text-xs font-semibold text-gray-400 tracking-wider">DATOS PROPORCIONADOS EN EL REGISTRO</h3>
                                    <!-- Grid de Datos -->
                                    <div class="grid grid-cols-2 gap-6">
                                        <div>
                                            <label class="block text-xs text-gray-500 mb-1">Nombre completo</label>
                                            <div class="p-2.5 bg-gray-50 border border-gray-200 rounded text-sm text-gray-900">
                                                @egresadoSeleccionado.Nombres @egresadoSeleccionado.ApellidoPaterno @egresadoSeleccionado.ApellidoMaterno
                                            </div>
                                        </div>
                                        <div>
                                            <label class="block text-xs text-gray-500 mb-1">Correo electrónico de contacto</label>
                                            <div class="p-2.5 bg-gray-50 border border-gray-200 rounded text-sm text-gray-900">
                                                @egresadoSeleccionado.Usuario?.Correo
                                            </div>
                                        </div>
                                        <div>
                                            <label class="block text-xs text-gray-500 mb-1">Programa educativo declarado</label>
                                            <div class="p-2.5 bg-gray-50 border border-gray-200 rounded text-sm text-gray-900">
                                                @egresadoSeleccionado.ProgramaEducativo?.NombrePrograma
                                            </div>
                                        </div>
                                        <div>
                                            <label class="block text-xs text-gray-500 mb-1">Año de egreso</label>
                                            <div class="p-2.5 bg-gray-50 border border-gray-200 rounded text-sm text-gray-900">
                                                @(egresadoSeleccionado.FechaEgreso?.ToString() ?? "No especificado")
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Caja de Consentimiento -->
                                    <div class="bg-green-50 border border-green-200 rounded-lg p-4 flex items-start space-x-3">
                                        <svg class="w-5 h-5 text-green-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                        <div>
                                            <h4 class="text-sm font-bold text-green-800">Consentimiento legal validado</h4>
                                            <p class="text-xs text-green-700 mt-1">El aspirante leyó y aceptó explícitamente los Términos de Servicio y el Aviso de Privacidad Institucional el día @egresadoSeleccionado.FechaAceptacionPrivacidad.ToString("dd 'de' MMMM 'de' yyyy 'a las' HH:mm") hrs (Timestamp del sistema).</p>
                                        </div>
                                    </div>

                                    <!-- Instrucción Operativa -->
                                    <div class="bg-blue-50 border-l-4 border-[#003366] rounded-r p-4 text-sm text-blue-900">
                                        <strong>Instrucción operativa:</strong> Por favor, coteje el nombre completo y el año de egreso en el sistema oficial antes de autorizar el acceso.
                                    </div>
                                </div>

                                <!-- Botones de Acción -->
                                <div class="p-6 bg-gray-50 border-t border-gray-100 flex justify-between items-center">
                                    <button @onclick="DenegarAcceso" class="px-6 py-2.5 border border-red-200 text-red-600 rounded text-sm font-medium hover:bg-red-50 transition-colors">
                                        Denegar registro
                                    </button>
                                    <button @onclick="AutorizarAcceso" class="px-6 py-2.5 bg-[#003366] text-white rounded text-sm font-medium hover:bg-[#002244] transition-colors">
                                        Autorizar acceso
                                    </button>
                                </div>
                            </div>
                        }   
                        else if (pendientes.Any())
                        {
                            <div class="flex items-center justify-center h-64 bg-white rounded-xl shadow-sm border border-gray-200">
                                <p class="text-gray-500">Selecciona una solicitud de la lista para revisar los detalles.</p>
                            </div>
                        }
                    </div>
                </main>
             </div>
        </div>
    </div>
</div>
@code {
    private Egresado? egresadoSeleccionado;
    private List<Egresado> pendientes = new();
    private ProgramaEducativo? programaActual;





    protected override async Task OnInitializedAsync()
    {
        int idUsuarioActual = 4;
        var asignacion = await DbContext.ProgramasResponsables
            .Include(pr => pr.ProgramaEducativo)
            .FirstOrDefaultAsync(pr => pr.IdUsuario == idUsuarioActual);

        if (asignacion != null)
        {
            programaActual = asignacion.ProgramaEducativo;
            await CargarSolicitudes();
        }
    }
    private async Task CargarSolicitudes()
    {
        if (programaActual == null) return;
        pendientes = await DbContext.Egresados
            .Include(e => e.Usuario)
            .Include(e => e.ProgramaEducativo)
            .Where(e => e.EstadoSolicitud == "Pendiente" && e.IdPrograma == programaActual.IdPrograma)
            .OrderBy(e => e.FechaSolicitud)
            .ToListAsync();
        //SELECCIONAR Primero
        if (pendientes.Any() && egresadoSeleccionado==null)
        {
            egresadoSeleccionado = pendientes.First();
        }
    }


    private void SeleccionarEgresado(Egresado egresado)
    {

        egresadoSeleccionado = egresado;
        StateHasChanged();
    }

    private async Task AutorizarAcceso()
    {
        if (egresadoSeleccionado != null)
        {
            egresadoSeleccionado.EstadoSolicitud = "Aprobado";
            //egresadoSeleccionado.IdUsuarioResolvio = usuarioActual.IdUsuario;
            await DbContext.SaveChangesAsync();
            egresadoSeleccionado = null;
            await CargarSolicitudes();
        }
    }

    private async Task DenegarAcceso()
    {
        if (egresadoSeleccionado != null)
        {
            egresadoSeleccionado.EstadoSolicitud = "Rechazado";
            await DbContext.SaveChangesAsync();
            egresadoSeleccionado = null;
            await CargarSolicitudes();
        }
    }
}
