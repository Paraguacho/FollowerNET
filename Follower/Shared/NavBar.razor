
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider

<nav class="bg-white border-b border-gray-200 px-6 py-3 flex justify-between items-center sticky top-0 z-40">
    <div class="text-[#003366] font-extrabold text-xl tracking-tight cursor-pointer" @onclick='() => NavManager.NavigateTo("/")'>
        EGRESADOS 
    </div>

    <AuthorizeView>
        <Authorized>

            <div class="hidden md:flex space-x-8">
                <a href="/" class="@ObtenerClaseActiva("/")">Tablero de avisos</a>

                <a href="/perfil" class="@ObtenerClaseActiva("/perfil")">Gestión mi perfil</a>

                <div class="relative flex items-center pb-4 -mb-4">
                    <a href="/encuestas" class="@ObtenerClaseActiva("/encuestas")">Encuestas</a>
                    <span class="absolute top-0 right-[-12px] flex h-4 w-4 items-center justify-center rounded-full bg-red-500 text-[10px] text-white font-bold">3</span>
                </div>
            </div>

            <!-- Perfil -->
            <div class="flex items-center space-x-4 cursor-pointer">
                @{
                    var nombreCompleto = context.User.Identity?.Name ?? "Usuario";
                    var iniciales = ObtenerIniciales(nombreCompleto);
                }

                <span class="text-sm font-medium text-gray-700">@nombreCompleto</span>
                <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center border border-gray-300">
                    <span class="text-gray-600 font-bold text-sm">@iniciales</span>
                </div>

                <!-- Cerrar Sesion-->
                <button @onclick="CerrarSesion" class="text-gray-400 hover:text-red-600 transition-colors" title="Cerrar sesión">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                </button>
            </div>

        </Authorized>
        <NotAuthorized>
            <div class="flex-column align-items-center space-x-4">
                <button @onclick='() => NavManager.NavigateTo("/registro")' class="px-5 py-2 border border-[#003366] text-[#003366] font-medium rounded-md hover:bg-gray-50 transition-colors">
                    Registrarse
                </button>
                <button @onclick='() => NavManager.NavigateTo("/login")' class="px-5 py-2 bg-[#003366] text-white font-medium rounded-md hover:bg-[#002244] transition-colors">
                    Iniciar sesión
                </button>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</nav>


@code{
    [Parameter]
    public string MenuActivo { get; set; } = "/"; // /index / /perfil / encuestas

    private string ObtenerClaseActiva(string ruta)
    {
        var rutaActual = new Uri(NavManager.Uri).AbsolutePath;
        bool esActiva = rutaActual.Equals(ruta, StringComparison.OrdinalIgnoreCase);
        return esActiva
            ? "text-[#003366] font-medium border-b-2 border-[#003366] pb-4 -mb-4" // Clases activas 
            : "text-gray-500 hover:text-gray-900 font-medium pb-4 -mb-4 transition-colors"; // Clases inactivas
    }

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += LocationChanged;
    }

    private void LocationChanged(object sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= LocationChanged;
    }

    private string ObtenerIniciales (string nombreCompleto)
    {
        if (string.IsNullOrWhiteSpace(nombreCompleto)) return "EG";

        var partes = nombreCompleto.Trim().Split(' ',StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1) return partes[0].Substring(0, 1).ToUpper(); // Solo tiene un nombre
        // Toma la primera letra de la primera palabra y la primera de la segunda
         return $"{partes[0][0]}{partes[1][0]}".ToUpper();
    }


    private async Task CerrarSesion()
    {
        if (AuthStateProvider is Follower.Auth.CustomAuthStateProvider customAuth)
        {
            await customAuth.CerrarSesion();
        }

     
        NavManager.NavigateTo("/", forceLoad: true);
    }
}